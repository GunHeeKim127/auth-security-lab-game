{
  "name": "auth-security-lab-game",
  "version": "1.0.0",
  "private": true,
  "description": "논문의 다중 보안 통제 효과를 체험하는 교육용 웹 방어 전략 게임",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit --incremental false",
    "test:game": "playwright test --config=playwright.game.config.ts",
    "package:brb": "powershell -ExecutionPolicy Bypass -File scripts/build-brb-package.ps1"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
