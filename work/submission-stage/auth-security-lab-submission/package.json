{
  "name": "auth-security-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:secure": "cross-env LAB_MODE=secure next dev -p 3002",
    "dev:auth-authz-only": "cross-env LAB_MODE=auth-authz-only next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3001",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "results:snapshot": "node scripts/save-test-summary.mjs",
    "results:csv": "node scripts/export-repeat-csv.mjs",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:baseline": "cross-env LAB_MODE=vulnerable playwright test --project=vulnerable",
    "test:secure": "cross-env LAB_MODE=secure playwright test --project=secure",
    "test:repeat": "playwright test --config=playwright.repeat.config.ts",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.0.0",
    "prisma": "^6.16.3",
    "typescript": "^5.9.2"
  }
}
